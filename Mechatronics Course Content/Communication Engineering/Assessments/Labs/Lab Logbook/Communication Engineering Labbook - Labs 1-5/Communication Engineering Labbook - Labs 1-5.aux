\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Primary physical evidence for Lab 3. The TIMS patch includes the AUDIO OSCILLATOR, SEQUENCE GENERATOR, LINE-CODE ENCODER, MULTIPLIER, PHASE SHIFTER, second MULTIPLIER, TUNEABLE LPF, DECISION MAKER and LINE-CODE DECODER. Two oscilloscopes were used to view analogue/modulated and digital-related signals.\relax }}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:lab3-setup}{{1}{5}{Primary physical evidence for Lab 3. The TIMS patch includes the AUDIO OSCILLATOR, SEQUENCE GENERATOR, LINE-CODE ENCODER, MULTIPLIER, PHASE SHIFTER, second MULTIPLIER, TUNEABLE LPF, DECISION MAKER and LINE-CODE DECODER. Two oscilloscopes were used to view analogue/modulated and digital-related signals.\relax }{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}What the manual asked me to investigate}{6}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Observed BPSK and transition behaviour}{7}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A clear class capture of a high-frequency yellow waveform viewed against a cyan binary sequence. The display shows CH1 20.0 V/div, CH2 50.0 V/div, 10.0 ms/div and a visible frequency readout of about 18.99 Hz for the selected channel. The repeated carrier-like waveform changes its relationship to the data at the sequence transitions, supporting the BPSK phase-transition investigation.\relax }}{7}{figure.caption.2}\protected@file@percent }
\newlabel{fig:lab3-bpsk}{{2}{7}{A clear class capture of a high-frequency yellow waveform viewed against a cyan binary sequence. The display shows CH1 20.0 V/div, CH2 50.0 V/div, 10.0 ms/div and a visible frequency readout of about 18.99 Hz for the selected channel. The repeated carrier-like waveform changes its relationship to the data at the sequence transitions, supporting the BPSK phase-transition investigation.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Bandwidth and demodulated waveform shape}{8}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Primary evidence that filtering changes transition shape and amplitude. The photos show rounded/oscillatory analogue transitions rather than a perfect rectangle. Exact probe points were not recorded, so the captions do not claim a more specific node than the images support.\relax }}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:lab3-filtering}{{3}{8}{Primary evidence that filtering changes transition shape and amplitude. The photos show rounded/oscillatory analogue transitions rather than a perfect rectangle. Exact probe points were not recorded, so the captions do not claim a more specific node than the images support.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Digital-related comparison}{9}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Two simultaneously observed digital-related traces on the second oscilloscope. The display shows 5.00 V/div on both channels and 50.0 ms/div. The yellow trace is a slower binary pattern; the cyan trace contains groups of fast transitions associated with that pattern. This supports the presence of coordinated data/clock or line-code signals, but the exact probe-point mapping was not written down and is therefore left unclaimed.\relax }}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:lab3-digital}{{4}{9}{Two simultaneously observed digital-related traces on the second oscilloscope. The display shows 5.00 V/div on both channels and 50.0 ms/div. The yellow trace is a slower binary pattern; the cyan trace contains groups of fast transitions associated with that pattern. This supports the presence of coordinated data/clock or line-code signals, but the exact probe-point mapping was not written down and is therefore left unclaimed.\relax }{figure.caption.4}{}}
